# Supabase (proyecto "Coyote Club", separado del de Rememberos)
NEXT_PUBLIC_SUPABASE_URL=https://bfheyibfyiafznehjzjf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña simple del panel /admin (login básico, sin usuarios múltiples)
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-larga
ADMIN_SESSION_SECRET=cambia-esto-tambien-por-algo-de-48-caracteres-o-mas-aleatorio

# Redsys — pide estos 3 datos al banco/TPV virtual del cliente (autónomo). Guía completa:
# docs/PUESTA-EN-MARCHA-REDSYS.md. Mientras estén vacíos, "Comprar" avisa de que el pago aún no está disponible.
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=001
REDSYS_SECRET_KEY=
# "test" = entorno de pruebas de Redsys; "live" solo cuando el banco active el comercio real
REDSYS_ENV=test
# URL pública del sitio, con https:// y sin barra final (Redsys avisa del pago a esta dirección)
NEXT_PUBLIC_SITE_URL=https://coyoteclub.example
