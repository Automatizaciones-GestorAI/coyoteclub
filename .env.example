# Supabase (proyecto "Coyote Club", separado del de Rememberos)
NEXT_PUBLIC_SUPABASE_URL=https://bfheyibfyiafznehjzjf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Primer acceso al panel: con la tabla de usuarios vacía, el usuario "admin" + esta contraseña crea el usuario inicial
# (que gestiona usuarios). A partir de ahí cada persona entra con su propio usuario y esta variable ya no se usa.
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-larga
ADMIN_SESSION_SECRET=cambia-esto-tambien-por-algo-de-48-caracteres-o-mas-aleatorio

# Stripe (cobro online). Guía completa: docs/PUESTA-EN-MARCHA-STRIPE.md. Mientras estén vacías, "Comprar" avisa de que el pago aún no está disponible.
# Clave secreta de la cuenta de Stripe del cliente (sk_test_... en pruebas, sk_live_... en real). Mejor una clave restringida (rk_...) solo con "Checkout Sessions: escritura".
STRIPE_SECRET_KEY=
# Secreto de firma del aviso (webhook) de Stripe: whsec_... (uno para pruebas y otro para real)
STRIPE_WEBHOOK_SECRET=
# (opcional) URL pública del sitio, con https:// y sin barra final. Si no está, se usa la dirección por la que se visita la web.
NEXT_PUBLIC_SITE_URL=https://coyoteclub.example
